  "actions": [
    {
      "name": "Mark as paid",
      "when": "Settles an open item (customer owes you, or you owe a supplier). Partial payments allowed.",
      "posting": "Money in: Dr Cash/Bank, Cr 1100 Accounts receivable. Money out: Dr 2000 Accounts payable, Cr Cash/Bank.",
      "guard": "Cannot exceed the open balance; closes the open item when settled."
    },
    {
      "name": "Refund or return",
      "when": "Customer returns goods or gets money back; or you return goods to a supplier.",
      "posting": "Customer refund: Dr 4900 Sales returns, Cr Cash/Bank (or 1100 if unpaid). If goods return to stock also Dr 1200, Cr 5000. Supplier return: Dr Cash/Bank (or 2000), Cr 1200.",
      "guard": "Linked to the original entry; cannot exceed the original amount."
    },
    {
      "name": "Apply customer deposit",
      "when": "Customer's earlier deposit is used against a sale.",
      "posting": "Dr 2100 Customer deposits, Cr 4000 Sales revenue (or 4100).",
      "guard": "Cannot exceed the deposit balance."
    },
    {
      "name": "Write off unpaid amount",
      "when": "Customer will not pay.",
      "posting": "Dr 6990 Other expenses (bad debt), Cr 1100 Accounts receivable.",
      "guard": "Requires a note; review flag."
    },
    {
      "name": "Edit or reverse",
      "when": "User changes or cancels a posted entry.",
      "posting": "Reversing entry swaps every debit and credit and links to the original; an edit then posts a new entry.",
      "guard": "Posted entries are never edited or deleted."
    }
  ],
  "system_entries": [
    {
      "name": "Opening balances",
      "posts": "Customer enters year-end figures (statement screens). One entry posts each balance; the difference goes to Owner's capital / Retained earnings.",
      "when": "Once per business, dated the day before the first daily entry."
    },
    {
      "name": "Depreciation",
      "posts": "Straight-line from the asset register: Dr 6800 Depreciation, Cr 1590 Accumulated depreciation.",
      "when": "Monthly, system generated."
    },
    {
      "name": "Accruals",
      "posts": "Month-end prompt: bills used but not yet billed. Dr expense, Cr 2200 Accrued expenses.",
      "when": "Monthly, user confirms."
    },
    {
      "name": "Prepaid release",
      "posts": "Month-end: part of a prepaid amount used up. Dr expense, Cr 1300 Prepaid expenses.",
      "when": "Monthly, system suggested."
    },
    {
      "name": "Stock count",
      "posts": "User counts stock; the difference posts Dr 5000, Cr 1200 (or the reverse).",
      "when": "Month-end prompt."
    },
    {
      "name": "Loan reclassification",
      "posts": "Portion of a long-term loan due within 12 months moves from 2600 to 2400.",
      "when": "Monthly or at period end, system generated."
    }
  ]
}